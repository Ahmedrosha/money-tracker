<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Net Worth" android:textSize="13sp" android:textColor="#7FD6C9" android:textStyle="bold"/>
    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="—" android:textSize="28sp" android:textColor="#E3EBE9" android:textStyle="bold" android:maxLines="1"/>
    <TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="#9FB0AD"/>
    <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="11sp" android:textColor="#7B8B89"/>
</LinearLayout>
